[Unit]
Description=Venderos Upload Receiver
After=network.target

[Service]
Type=simple
User=sauki
WorkingDirectory=/home/sauki/venderos-server
EnvironmentFile=/etc/venderos.env
ExecStart=/usr/bin/python3 /home/sauki/venderos-server/recv.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
